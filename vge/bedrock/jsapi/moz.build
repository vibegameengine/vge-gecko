DIRS += [
    "buffers",
    "classes",
    "gc",
    "objects",
    "platform",
    "proxies",
    "scripts",
]

UNIFIED_SOURCES += [
    "VgeJsHeap.cpp",
    "VgeJsMisc.cpp",
    "VgeJsRuntime.cpp",
    "VgeJsValues.cpp",
]

include("/vge/bedrock/v8.mozbuild")

OS_LIBS += [
    "%s/Lib/Win64MD/wee8" % CONFIG["VGE_V8_DIR"],
    "dbghelp",
    "winmm",
]

GeneratedFile("icudtl.dat", script="copy_icu_data.py", flags=[])

FINAL_TARGET_FILES += ["!icudtl.dat"]

FINAL_LIBRARY = "js"
