DIRS += [
    "buffers",
    "classes",
    "gc",
    "objects",
    "platform",
    "proxies",
    "scripts",
]

UNIFIED_SOURCES += [
    "VgeJsHeap.cpp",
    "VgeJsMisc.cpp",
    "VgeJsRuntime.cpp",
    "VgeJsValues.cpp",
]

include("/vge/bedrock/v8.mozbuild")

OS_LIBS += [
    "%s/Lib/Win64MD/wee8" % CONFIG["VGE_V8_DIR"],
    "dbghelp",
    "winmm",
]

FINAL_LIBRARY = "js"
